# Required for live GBIF downloads
GBIF_USERNAME=your-gbif-username
GBIF_PASSWORD=your-gbif-password
GBIF_EMAIL=you@example.org

# Application
HOST=0.0.0.0
PORT=3000
DATA_DIR=/data
DATABASE_PATH=/data/manager.sqlite
ARTIFACT_DIR=/data/artifacts

# Optional HTTP Basic Auth for both Web UI and API
APP_USERNAME=admin
APP_PASSWORD=change-me

# Worker defaults
GBIF_POLL_INTERVAL_SECONDS=60
GBIF_ATTEMPT_TIMEOUT_HOURS=12
GBIF_RETRY_INTERVAL_SECONDS=3600
ARTIFACT_RETENTION_DAYS=30
WORKER_TICK_SECONDS=1
MAX_CONCURRENT_LIVE_JOBS=1
REPLAY_DURATION_SECONDS=8
# Full hashing can be expensive for multi-GB fixtures; size is always checked.
REPLAY_VERIFY_SHA256=false

# 0 means unlimited retries
MAX_ATTEMPTS=0

# Keep invalid ZIPs for diagnosis. They are otherwise deleted after validation.
KEEP_INVALID_ARTIFACTS=false

# Safety limits for ZIP validation
MAX_ZIP_ENTRY_UNCOMPRESSED_BYTES=21474836480
MAX_ZIP_TOTAL_UNCOMPRESSED_BYTES=53687091200
MAX_ZIP_COMPRESSION_RATIO=1000
